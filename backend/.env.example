# FoodBridge Backend — Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# Application
NODE_ENV=development          # development | production
PORT=5000
API_VERSION=v1

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/foodbridge
# For production use MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/foodbridge?retryWrites=true&w=majority

# JSON Web Token
# Generate a strong secret: node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_SECRET=your_jwt_secret_here_minimum_64_characters_replace_this
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:4200    # Angular dev server
# For production: CORS_ORIGIN=https://foodbridge.yourdomain.com
